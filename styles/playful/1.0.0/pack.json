          "src": "aevalsrc='0.5*sin(2*PI*t*(700+1400*t))*(1-exp(-30*t))*exp(-3*t)':s=48000:d=0.45",
          "filters": "afade=t=out:st=0.35:d=0.1",
          "variants": [
            1.0,
            1.06,
            0.94
          ]
        }
      }
