{
  "id": "luxe",
  "version": "1.0.0",
  "name": "Luxe",
  "description": "Quiet, expensive and unhurried: light serif type with wide spacing, fine drawn lines, lots of space, slow graceful motion, soft shimmering sounds.",
  "aspects": {
    "typography": {},
    "captions": {
      "recommended": {
        "style": "phrase_lines",
        "animation": "rise",
        "emphasis": "italic"
      },
      "treatment": {
        "font": "body",
        "weight": 400,
        "letter_spacing": ".02em",
        "in_s": 0.45
      }
    },
    "components": {
