    "motion": {
      "note": "slow fade-and-rise, drawn lines, no bounce"
    },
    "shape": {},
    "sound": {
      "by_event": {
        "zoom_punch": "swish",
        "graphic_in": "shimmer",
        "emoji": "shimmer",
        "cta": "chime",
        "headline": "chime",
        "tick": "shimmer"
      },
      "gain_offset_db": -4,
      "recipes": {
        "shimmer": {
          "src": "aevalsrc='0.25*sin(2*PI*2093*t)*exp(-3*t)+0.2*sin(2*PI*3136*t)*exp(-4*t)+0.15*sin(2*PI*4186*t)*exp(-5*t)':s=48000:d=1.4",
          "filters": "afade=t=in:st=0:d=0.08,aecho=0.7:0.6:60|120:0.35|0.25,volume=1.4",
          "variants": [
            1.0,
            1.06,
            0.94
          ]
        },
        "swish": {
          "src": "anoisesrc=color=white:amplitude=0.5:duration=0.9:sample_rate=48000",
          "filters": "highpass=f=2500,lowpass=f=9000,afade=t=in:st=0:d=0.45:curve=exp,afade=t=out:st=0.45:d=0.45,volume=5",
          "variants": [
            1.0,
            1.06,
            0.94
          ]
        },
        "chime": {
          "src": "aevalsrc='0.4*sin(2*PI*1568*t)*exp(-2.5*t)+0.2*sin(2*PI*2349*t)*exp(-3.5*t)':s=48000:d=1.8",
          "filters": "afade=t=in:st=0:d=0.01,afade=t=out:st=1.5:d=0.3",
          "variants": [
            1.0,
            1.06,
            0.94
          ]
        }
      }
    },
